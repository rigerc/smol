# Optional environment inputs. smol does not load this file automatically.
# Config discovery: XDG_CONFIG_HOME takes precedence over HOME.
# export XDG_CONFIG_HOME="$HOME/.config"

# Auto color is disabled when NO_COLOR is nonempty or TERM=dumb.
# export NO_COLOR=1
# export TERM=dumb

# The user module reads USER, falling back to LOGNAME.
# The shell module displays the basename of SHELL.
# export USER=ada
# export LOGNAME=ada
# export SHELL=/bin/bash

# System config directories, searched after the user config (first match wins).
# export XDG_CONFIG_DIRS=/etc/xdg

# Best-effort terminal detection (first available marker wins).
# export TERM_PROGRAM=kitty
# export KITTY_PID=1234
# export WEZTERM_EXECUTABLE=/usr/bin/wezterm
# export WT_SESSION=session-id
# export SSH_TTY=/dev/pts/0
# export SSH_CONNECTION='192.0.2.1 1234 192.0.2.2 22'

# Desktop/session detection; inherited from your graphical session.
# export XDG_CURRENT_DESKTOP=GNOME
# export DESKTOP_SESSION=gnome
# export WAYLAND_DISPLAY=wayland-0
# export HYPRLAND_INSTANCE_SIGNATURE=instance-id
# export SWAYSOCK=/run/user/1000/sway-ipc.sock

# WSL virtualization marker.
# export WSL_DISTRO_NAME=Ubuntu

# smol init also uses HOME/XDG_CONFIG_HOME for its destination, but ignores
# XDG_CONFIG_DIRS. It confirms SHELL before printing startup instructions.
# TERM=dumb, missing cursor capabilities, or narrow terminals select numbered
# prompts. NO_COLOR disables wizard chrome even with output color=always.
# Face randomness is configured in TOML ([face] random = true), not via env.
